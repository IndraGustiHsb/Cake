
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Custom Cake Dashboard</title>
<style>
:root {
  --bg:#050d20; --panel:#0b1933; --panel2:#101f3d;
  --pink:#ed3e91; --purple:#9b5cf6; --cyan:#20d7f5;
  --text:#eef4ff; --muted:#8fa5c7; --border:#243c65;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
font-family:Inter,Segoe UI,Arial,sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{width:225px;background:#08142c;border-right:1px solid var(--border);
padding:25px 16px;flex-shrink:0}
.brand{text-align:center;margin-bottom:35px}
.logo{font-size:42px;color:#ff69b4}
.brand h2{font-family:Georgia,serif;font-style:italic;margin:5px 0;color:#ff9bc9}
.brand small{color:var(--muted)}
.nav{display:grid;gap:10px}
.nav button{background:transparent;border:0;color:#c5d3eb;
padding:14px;text-align:left;border-radius:10px}
.nav button.active,.nav button:hover{background:linear-gradient(90deg,#e83d91,#9949d7);color:white}
.sidebar-note{margin-top:90px;text-align:center;color:#ff9bc9;font-family:Georgia;font-style:italic}
.main{flex:1;min-width:0;padding:25px}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;
margin-bottom:25px;flex-wrap:wrap}
.topbar h1{font-size:26px;margin:0}
.topbar p{color:var(--muted);margin:6px 0}
.button{border:0;border-radius:10px;padding:11px 17px;color:white;
background:linear-gradient(110deg,var(--pink),var(--purple));font-weight:700}
.button.secondary{background:#172c4d;border:1px solid var(--border)}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
.stat,.panel{background:linear-gradient(145deg,#0e1e3b,#09162d);
border:1px solid var(--border);border-radius:15px}
.stat{padding:19px}
.stat small{color:var(--muted)}
.stat strong{display:block;font-size:25px;margin-top:12px}
.stat .emoji{font-size:23px}
.section{margin-top:22px}
.section-head{display:flex;justify-content:space-between;align-items:center;
gap:12px;flex-wrap:wrap;margin-bottom:14px}
.section-head h2{font-size:19px;margin:0}
.panel{padding:19px}
.tools{display:flex;gap:10px;flex-wrap:wrap}
.tools input,.tools select,.field input,.field select,.field textarea{
background:#07152d;border:1px solid #29446f;color:white;
border-radius:9px;padding:11px;outline:none}
.tools input{min-width:220px}
.catalog{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.cake{background:#0b1b36;border:1px solid var(--border);border-radius:14px;overflow:hidden}
.cake img{width:100%;height:190px;object-fit:cover;background:#17294a}
.cake-info{padding:14px}
.cake-info h3{margin:0 0 6px;font-size:16px}
.category{color:#ff83bd;font-size:12px}
.price{font-weight:800;font-size:18px;margin:12px 0}
.desc{font-size:13px;color:var(--muted);min-height:34px}
.actions{display:flex;gap:7px;margin-top:12px}
.actions button{flex:1;padding:8px;border:1px solid var(--border);
border-radius:7px;background:#17294a;color:white}
.actions .delete{color:#ff789e}
.empty{text-align:center;padding:45px;color:var(--muted);grid-column:1/-1}
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.bar-row{display:grid;grid-template-columns:120px 1fr 45px;gap:10px;
align-items:center;margin:15px 0;font-size:13px}
.bar{height:11px;border-radius:20px;background:#17294a;overflow:hidden}
.bar span{display:block;height:100%;background:linear-gradient(90deg,var(--pink),var(--purple))}
footer{text-align:center;color:var(--muted);font-size:12px;margin:28px}
.modal{display:none;position:fixed;inset:0;background:#000b;
align-items:center;justify-content:center;padding:15px;z-index:10}
.modal.show{display:flex}
.dialog{width:100%;max-width:550px;max-height:95vh;overflow:auto;
background:#0b1933;border:1px solid #38517d;border-radius:16px;padding:22px}
.dialog h2{margin-top:0}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.field{display:grid;gap:7px;margin-bottom:13px}
.field label{font-size:13px;color:#c4d4ef}
.field input,.field select,.field textarea{width:100%}
.field.full{grid-column:1/-1}
.field textarea{min-height:85px;resize:vertical}
.preview{width:100%;height:180px;object-fit:cover;border-radius:10px;
background:#17294a;border:1px dashed #526d9c}
.form-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:15px}
@media(max-width:1100px){.catalog{grid-template-columns:repeat(3,1fr)}}
@media(max-width:800px){
.sidebar{width:65px;padding:15px 7px}.brand h2,.brand small,.nav span,.sidebar-note{display:none}
.brand .logo{font-size:30px}.nav button{text-align:center;padding:13px 5px}
.main{padding:16px}.stats{grid-template-columns:repeat(2,1fr)}
.catalog{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
.topbar h1{font-size:21px}.catalog{grid-template-columns:1fr 1fr;gap:9px}
.cake img{height:130px}.cake-info{padding:10px}.cake-info h3{font-size:14px}
.price{font-size:15px}.stats{gap:8px}.stat{padding:12px}
.stat strong{font-size:19px}.chart-grid{grid-template-columns:1fr}
.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="brand">
    <div class="logo">♕</div>
    <h2>Custom Cake</h2>
    <small>Sweet Moment, Better Together</small>
  </div>
  <nav class="nav">
    <button class="active" onclick="goTo('dashboard')">🏠 <span>Dashboard</span></button>
    <button onclick="goTo('catalog')">🎂 <span>Katalog Cake</span></button>
    <button onclick="openForm()">➕ <span>Update Cake</span></button>
    <button onclick="goTo('report')">📊 <span>Laporan Katalog</span></button>
  </nav>
  <div class="sidebar-note">Life is better<br>with cake ♡</div>
</aside>

<main class="main">
<header class="topbar">
  <div>
    <h1>Cake Sales Dashboard</h1>
    <p>Custom Cake Business · Product Management</p>
  </div>
  <button class="button" onclick="openForm()">＋ Tambah Cake Baru</button>
</header>

<section class="stats" id="dashboard">
  <div class="stat"><span class="emoji">🎂</span><small> Total Produk Cake</small><strong id="total">0</strong></div>
  <div class="stat"><span class="emoji">💗</span><small> Total Kategori</small><strong id="categories">0</strong></div>
  <div class="stat"><span class="emoji">💰</span><small> Rata-rata Harga</small><strong id="average">Rp 0</strong></div>
  <div class="stat"><span class="emoji">🛍️</span><small> Nilai Seluruh Katalog</small><strong id="catalogValue">Rp 0</strong></div>
</section>

<section class="section chart-grid" id="report">
  <div class="panel">
    <div class="section-head"><h2>📊 Komposisi Kategori Cake</h2></div>
    <div id="chart"></div>
  </div>
  <div class="panel">
    <div class="section-head"><h2>✨ Informasi Dashboard</h2></div>
    <p style="color:var(--muted);line-height:1.8;font-size:14px">
      Dashboard ini menyimpan katalog dan foto cake di browser perangkat Anda.
      Gunakan menu Tambah Cake Baru untuk memperbarui koleksi.
      Nilai katalog adalah jumlah harga seluruh produk, bukan omzet penjualan aktual.
    </p>
    <button class="button secondary" onclick="exportData()">⬇ Backup Data JSON</button>
    <label class="button secondary" style="display:inline-block;margin:8px 0">
      ⬆ Import Backup
      <input type="file" accept=".json" hidden onchange="importData(event)">
    </label>
  </div>
</section>

<section class="section" id="catalog">
  <div class="section-head">
    <h2>🎂 Katalog Custom Cake</h2>
    <div class="tools">
      <input id="search" placeholder="Cari nama cake..." oninput="render()">
      <select id="filter" onchange="render()"><option value="">Semua Kategori</option></select>
    </div>
  </div>
  <div class="catalog" id="products"></div>
</section>
<footer>Custom Cake Dashboard · Data tersimpan secara lokal di browser Anda</footer>
</main>
</div>

<div class="modal" id="modal">
<div class="dialog">
  <h2 id="formTitle">Tambah Cake Baru</h2>
  <form id="cakeForm">
    <input type="hidden" id="cakeId">
    <div class="field">
      <label>Foto Cake</label>
      <img id="preview" class="preview" alt="Preview foto cake">
      <input id="photo" type="file" accept="image/*" onchange="previewPhoto(event)">
      <small style="color:var(--muted)">Pilih foto JPG, PNG, atau WebP.</small>
    </div>
    <div class="form-grid">
      <div class="field">
        <label>Nama Cake</label>
        <input id="name" required placeholder="Contoh: Strawberry Dream">
      </div>
      <div class="field">
        <label>Kategori Cake</label>
        <select id="category" required>
          <option value="">Pilih kategori</option>
          <option>Birthday Cake</option>
          <option>Wedding Cake</option>
          <option>Custom Design</option>
          <option>Chocolate Cake</option>
          <option>Cheese Cake</option>
          <option>Others</option>
        </select>
      </div>
      <div class="field full">
        <label>Harga Cake (Rp)</label>
        <input id="price" type="number" min="0" required placeholder="Contoh: 450000">
      </div>
      <div class="field full">
        <label>Deskripsi Cake</label>
        <textarea id="description" placeholder="Deskripsikan rasa, ukuran, dekorasi, dan detail cake..."></textarea>
      </div>
    </div>
    <div class="form-actions">
      <button type="button" class="button secondary" onclick="closeForm()">Batal</button>
      <button type="submit" class="button">💾 Simpan Cake</button>
    </div>
  </form>
</div>
</div>

<script>
const KEY = "custom_cake_products_v1";
const placeholder = "https://placehold.co/600x400/101f3d/ff83bd?text=Custom+Cake";
let products = [];
let selectedPhoto = "";

function load(){
  try {
    products = JSON.parse(localStorage.getItem(KEY) || "[]");
    if(!Array.isArray(products)) products=[];
  } catch(e){ products=[]; }
  if(!products.length){
    products = [
      {id:1,name:"Strawberry Dream",category:"Birthday Cake",price:450000,
       description:"Vanilla cake dengan strawberry dan cream lembut.",photo:placeholder},
      {id:2,name:"Choco Velvet",category:"Custom Design",price:500000,
       description:"Chocolate cake dengan dekorasi cokelat premium.",photo:placeholder},
      {id:3,name:"Elegant Rose",category:"Wedding Cake",price:650000,
       description:"Cake elegan dengan dekorasi bunga buttercream.",photo:placeholder},
      {id:4,name:"Galaxy Cake",category:"Custom Design",price:550000,
       description:"Tema galaksi dengan warna dan dekorasi custom.",photo:placeholder}
    ];
    save();
  }
}
function save(){
  try{
    localStorage.setItem(KEY,JSON.stringify(products));
    return true;
  }catch(e){
    alert("Penyimpanan browser penuh. Kurangi ukuran foto atau hapus produk lama.");
    return false;
  }
}
function rupiah(n){
  return "Rp "+Number(n||0).toLocaleString("id-ID");
}
function render(){
  const q=document.getElementById("search").value.toLowerCase();
  const cat=document.getElementById("filter").value;
  const list=products.filter(p=>
    p.name.toLowerCase().includes(q) && (!cat||p.category===cat)
  );
  document.getElementById("products").innerHTML=list.length?list.map(p=>`
    <article class="cake">
      <img src="${p.photo||placeholder}" alt="${escapeHtml(p.name)}">
      <div class="cake-info">
        <h3>${escapeHtml(p.name)}</h3>
        <div class="category">${escapeHtml(p.category)}</div>
        <div class="price">${rupiah(p.price)}</div>
        <div class="desc">${escapeHtml(p.description||"Custom cake pilihan Anda.")}</div>
        <div class="actions">
          <button onclick="editCake(${p.id})">✏️ Edit</button>
          <button class="delete" onclick="deleteCake(${p.id})">🗑 Hapus</button>
        </div>
      </div>
    </article>`).join(""):`<div class="empty">Belum ada cake ditemukan.</div>`;

  const cats=[...new Set(products.map(p=>p.category))];
  const filter=document.getElementById("filter");
  const old=filter.value;
  filter.innerHTML='<option value="">Semua Kategori</option>'+
    cats.map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join("");
  filter.value=cats.includes(old)?old:"";

  document.getElementById("total").textContent=products.length;
  document.getElementById("categories").textContent=cats.length;
  const sum=products.reduce((a,p)=>a+Number(p.price),0);
  document.getElementById("average").textContent=rupiah(products.length?sum/products.length:0);
  document.getElementById("catalogValue").textContent=rupiah(sum);
  renderChart(cats);
}
function renderChart(cats){
  const el=document.getElementById("chart");
  if(!cats.length){el.innerHTML="Belum ada data.";return;}
  const colors=["#ed3e91","#9b5cf6","#20d7f5","#ffad55","#29d69a"];
  el.innerHTML=cats.map((c,i)=>{
    const count=products.filter(p=>p.category===c).length;
    const percent=count/products.length*100;
    return `<div class="bar-row">
      <span>${escapeHtml(c)}</span>
      <div class="bar"><span style="width:${percent}%;background:${colors[i%colors.length]}"></span></div>
      <b>${count}</b>
    </div>`;
  }).join("");
}
function escapeHtml(s){
  return String(s??"").replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[c]);
}
function openForm(){
  document.getElementById("cakeForm").reset();
  document.getElementById("cakeId").value="";
  selectedPhoto="";
  document.getElementById("preview").src=placeholder;
  document.getElementById("formTitle").textContent="Tambah Cake Baru";
  document.getElementById("modal").classList.add("show");
}
function closeForm(){
  document.getElementById("modal").classList.remove("show");
}
function editCake(id){
  const p=products.find(x=>x.id===id);
  if(!p)return;
  openForm();
  document.getElementById("formTitle").textContent="Edit Cake";
  document.getElementById("cakeId").value=p.id;
  document.getElementById("name").value=p.name;
  document.getElementById("category").value=p.category;
  document.getElementById("price").value=p.price;
  document.getElementById("description").value=p.description||"";
  selectedPhoto=p.photo||placeholder;
  document.getElementById("preview").src=selectedPhoto;
}
function deleteCake(id){
  const p=products.find(x=>x.id===id);
  if(!p||!confirm("Hapus cake "+p.name+"?"))return;
  products=products.filter(x=>x.id!==id);
  if(save())render();
}
function previewPhoto(event){
  const file=event.target.files[0];
  if(!file)return;
  if(!file.type.startsWith("image/")){
    alert("File harus berupa gambar.");return;
  }
  if(file.size>1200000){
    alert("Ukuran foto maksimal 1,2 MB agar penyimpanan browser tidak cepat penuh.");
    event.target.value="";return;
  }
  const reader=new FileReader();
  reader.onload=()=>{
    selectedPhoto=reader.result;
    document.getElementById("preview").src=selectedPhoto;
  };
  reader.readAsDataURL(file);
}
document.getElementById("cakeForm").addEventListener("submit",e=>{
  e.preventDefault();
  const id=document.getElementById("cakeId").value;
  const old=products.find(p=>p.id===Number(id));
  const item={
    id:id?Number(id):Date.now(),
    name:document.getElementById("name").value.trim(),
    category:document.getElementById("category").value,
    price:Number(document.getElementById("price").value),
    description:document.getElementById("description").value.trim(),
    photo:selectedPhoto||(old&&old.photo)||placeholder
  };
  if(!item.name||!item.category||!Number.isFinite(item.price)||item.price<0)return;
  const next=id?products.map(p=>p.id===item.id?item:p):[item,...products];
  const previous=products;
  products=next;
  if(save()){
    closeForm();
    render();
  }else{
    products=previous;
  }
});
function exportData(){
  const blob=new Blob([JSON.stringify(products,null,2)],{type:"application/json"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;a.download="backup-custom-cake.json";a.click();
  URL.revokeObjectURL(url);
}
function importData(event){
  const file=event.target.files[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=()=>{
    try{
      const data=JSON.parse(reader.result);
      if(!Array.isArray(data)||!data.every(p=>p.name&&p.category&&Number.isFinite(Number(p.price))))
        throw new Error("Format tidak valid");
      if(!confirm("Ganti katalog sekarang dengan data backup?"))return;
      const old=products;products=data;
      if(save())render();else products=old;
    }catch(e){alert("File backup tidak valid.");}
  };
  reader.readAsText(file);
  event.target.value="";
}
function goTo(id){
  document.getElementById(id).scrollIntoView({behavior:"smooth"});
  document.querySelectorAll(".nav button").forEach(b=>b.classList.remove("active"));
  event.currentTarget.classList.add("active");
}
load();
render();
</script>
</body>
</html>
